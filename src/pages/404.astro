---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="The page you were looking for isn't here." noindex>
  <section class="section">
    <div class="wrap notfound">
      <h1>This page isn’t here</h1>
      <p class="lede">The link may be out of date, or the address may have a typo. Try one of these instead.</p>
      <div class="btn-row">
        <a class="btn btn--primary" href="/">Go to the home page</a>
        <a class="btn btn--secondary" href="/contact/">Contact us</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .notfound {
    max-width: 44rem;
    min-height: 40vh;
  }
</style>
