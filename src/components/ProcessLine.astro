---
/** The four-step managed-service process, joined by the same trace line as the hero. */
import { steps } from '../data/content';
---
<ol class="process" role="list">
  {steps.map((step, i) => (
    <li class="process__step">
      <span class="process__num" aria-hidden="true">{i + 1}</span>
      <h3 class="process__name"><span class="visually-hidden">Step {i + 1}: </span>{step.name}</h3>
      <p>{step.short}</p>
    </li>
  ))}
</ol>

<style>
  .process {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
  }

  .process__step {
    position: relative;
    padding: 0 0 2rem 4rem;
    margin: 0;
  }

  .process__step:last-child {
    padding-bottom: 0;
  }

  .process__step:not(:last-child)::before {
    content: '';
    position: absolute;
    left: calc(1.375rem - 1px);
    top: 2.75rem;
    bottom: 0;
    border-left: 2px dashed var(--teal-bright);
  }

  .process__num {
    position: absolute;
    left: 0;
    top: 0;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--surface);
    border: 2px solid var(--blue);
    color: var(--blue);
    font-family: var(--font-display);
    font-weight: 650;
    font-size: 1.125rem;
  }

  .process__name {
    margin: 0.55rem 0 0.4rem;
  }

  .process__step p {
    margin: 0;
    color: var(--ink-soft);
  }

  @media (min-width: 52rem) {
    .process {
      grid-template-columns: repeat(4, 1fr);
      gap: 2rem;
    }

    .process__step {
      padding: 4rem 0 0;
    }

    .process__step:not(:last-child)::before {
      left: 2.75rem;
      right: -2rem;
      top: calc(1.375rem - 1px);
      bottom: auto;
      border-left: 0;
      border-top: 2px dashed var(--teal-bright);
    }

    .process__name {
      margin-top: 0;
    }
  }
</style>
